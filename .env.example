# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000


MOBILE_APP_SCHEME=infoversemobile

# Database
MONGO_URI=mongodb+srv://admin:<db_password>@infoverse.jinjgyc.mongodb.net/

# Auth
JWT_SECRET=<your_generated_secret>
JWT_EXPIRES_IN=1d

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379

# AI
GEMINI_API_KEY=<your_google_ai_key>

# Payments (Optional - defaults to false if missing)
PAYMENT_ENABLED=true
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=<your_paystack_secret_key>
PAYSTACK_PUBLIC_KEY=<your_paystack_public_key>
TRIAL_DAYS=7
SCHOOL_TRIAL_DAYS=14

# Oak API
OAK_API_BASE_URL=https://open-api.thenational.academy/api/v0
OAK_API_KEY=0d80d7dd-8398-42cc-89e8-3c74bd7c76d8
OAK_API_RATE_LIMIT=100


GOOGLE_OAUTH_CLIENT_ID=<your_google_web_client_id>.apps.googleusercontent.com
GOOGLE_OAUTH_IOS_CLIENT_ID=<your_google_ios_client_id>.apps.googleusercontent.com
GOOGLE_OAUTH_ANDROID_CLIENT_ID=<your_google_android_client_id>.apps.googleusercontent.com

# Mailing Configuration (Zoho)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=your-email@zoho.com
SMTP_PASS=your-app-password
EMAIL_FROM=Infoverse Support